{
  "$defs": {
    "CheckStatus": {
      "enum": [
        "pending",
        "passed",
        "failed",
        "error",
        "skipped",
        "no_tests"
      ],
      "title": "CheckStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "candidate_hash": {
      "title": "Candidate Hash",
      "type": "string"
    },
    "command": {
      "items": {
        "type": "string"
      },
      "title": "Command",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "definition_id": {
      "title": "Definition Id",
      "type": "string"
    },
    "duration_ms": {
      "minimum": 0,
      "title": "Duration Ms",
      "type": "number"
    },
    "exit_code": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Exit Code"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "output_artifact_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Artifact Id"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/CheckStatus"
    },
    "task_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Task Id"
    },
    "tests_collected": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tests Collected"
    }
  },
  "required": [
    "id",
    "project_id",
    "definition_id",
    "candidate_hash",
    "status",
    "command",
    "duration_ms"
  ],
  "title": "Check",
  "type": "object"
}
