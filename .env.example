# Environment variables the controller actually reads. All are optional.

# Controller state directory (database, artifacts, worktrees, tokens, policy.json).
# Default: ~/.local/state/stack-agent
STACK_AGENT_STATE=

# Controller log level for CLI commands: DEBUG, INFO, WARNING (default), ERROR.
STACK_AGENT_LOG_LEVEL=WARNING

# Set to 1 to make `stack-agent serve` echo the operator token; by default it only
# prints the path of the 0600 token file.
STACK_AGENT_PRINT_TOKEN=

# Optional local tools probed by `stack-agent doctor --project PATH`.
# NEXUS MCP server entry point (default: ~/Projects/MCPs/nexus-mcp-server/dist/server.js)
NEXUS_SERVER_SCRIPT=
# SDLC command-center source CLI fallback
# (default: ~/Projects/MCPs/autonomous-sdlc-command-center/mcp/sdlc_cli.py)
SDLC_CLI_SCRIPT=

# Never set STACK_AGENT_GRANT by hand: the controller injects a short-lived signed grant
# into each provider process for the MCP bridge.
